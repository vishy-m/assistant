# Assistant secrets. Copy to .env (Scripts/install-dev-agent.sh does this for
# you) and fill in. .env is gitignored and should stay chmod 600.
#
# The daemon re-reads this file on every use, so edits apply without a
# restart. The Settings / onboarding screens also write here, and the Google
# sign-in flow saves GOOGLE_OAUTH_REFRESH_TOKEN automatically.

# Claude: console.anthropic.com
ANTHROPIC_API_KEY=

# Optional fallback providers
OPENAI_API_KEY=
# Gemini: get a key at aistudio.google.com
GEMINI_API_KEY=
GEMMA_HOSTED_API_KEY=

# Google Calendar: Desktop App OAuth client secret (the client ID is set in Settings)
GOOGLE_OAUTH_CLIENT_SECRET=

# Written by the app after you connect Google; no need to fill in by hand
GOOGLE_OAUTH_REFRESH_TOKEN=
